+void SX126xWriteBuffer( uint8_t offset, uint8_t *buffer, uint8_t size )
+{
+    SX126xCheckDeviceReady( );
+    if (bsp_sx126x_fault_get() != 0U) return;
+
+    xSemaphoreTake(radio_mutex, portMAX_DELAY);
+    sx1262_nss_set(0);
+    uint8_t tx_buf[2];
+    tx_buf[0] = RADIO_WRITE_BUFFER;
+    tx_buf[1] = offset;
+    spi_write_byte(( uint8_t *)tx_buf, sizeof(tx_buf));
+    spi_write_byte( buffer, size);
+    sx1262_nss_set(1);
+    xSemaphoreGive(radio_mutex);
+
+    SX126xWaitOnBusy( );
+}
+
+void SX126xReadBuffer( uint8_t offset, uint8_t *buffer, uint8_t size )
+{
+    SX126xCheckDeviceReady( );
+    if (bsp_sx126x_fault_get() != 0U) {
+        if (buffer && size) memset(buffer, 0, size);
+        return;
+    }
+
+    xSemaphoreTake(radio_mutex, portMAX_DELAY);
+    sx1262_nss_set(0);
+    uint8_t tx_buf[3];
+    tx_buf[0] = RADIO_READ_BUFFER;
+    tx_buf[1] = offset;
+    tx_buf[2] = 0;
+    spi_write_byte(( uint8_t *)tx_buf, sizeof(tx_buf));
+    spi_read_byte(buffer, size);
+
+    sx1262_nss_set(1);
+    xSemaphoreGive(radio_mutex);
+    
+    SX126xWaitOnBusy( );
+}
