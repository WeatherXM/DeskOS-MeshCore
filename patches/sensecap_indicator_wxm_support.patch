+    gpio_config_t io_conf = {};
+    io_conf.intr_type = GPIO_INTR_NEGEDGE; //falling edge
+    io_conf.pin_bit_mask = (1ULL << ESP32_EXPANDER_IO_INT);
+    io_conf.mode = GPIO_MODE_INPUT;
