+uint32_t SX126xGetDio1PinState( void )
+{
+    uint16_t pin_val;
+    esp_err_t ret = indicator_io_expander->read_input_pins16(&pin_val);
+    if( ret == ESP_OK ) {
+        if( (pin_val & (0x01 << EXPANDER_IO_RADIO_DIO_1)) ) {
+            return 1;
+        }
+    }
+    return 0;
+}
