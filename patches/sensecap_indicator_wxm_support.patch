+static void latch_radio_bus_fault(uint32_t fault)
+{
+    uint32_t expected = 0U;
+    if (__atomic_compare_exchange_n(&radio_bus_fault, &expected, fault, false,
+                                    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+        uint32_t count = __atomic_load_n(&radio_bus_fault_count, __ATOMIC_RELAXED);
+        while (count != UINT32_MAX &&
+               !__atomic_compare_exchange_n(&radio_bus_fault_count, &count,
+                                             count + 1U, false,
+                                             __ATOMIC_RELAXED,
+                                             __ATOMIC_RELAXED)) {
+        }
+    }
+}
