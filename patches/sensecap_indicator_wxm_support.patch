+static bool spi_write_byte(uint8_t* data_in, size_t DataLength )
+{
+    if (bsp_sx126x_fault_get() != 0U) return false;
+#ifdef SX126X_SPI_DBUG
+    printf("spi write: ");
+    for(int i =0; i < DataLength ; i++) {
+        printf("%x ",data_in[i]);
+    }
+    printf("\r\n");
+#endif
+
+	spi_transaction_t SPITransaction;
+
+	if ( DataLength > 0 ) {
+		memset( &SPITransaction, 0, sizeof( spi_transaction_t ) );
+		SPITransaction.length = DataLength * 8;
+		SPITransaction.tx_buffer = data_in;
+		SPITransaction.rx_buffer = NULL;
+        if (spi_device_transmit(SpiHandle, &SPITransaction) != ESP_OK) {
+            latch_radio_bus_fault(3U);
+            return false;
+        }
+	}
+
+	return true;
+}
+
+static bool spi_read_byte(uint8_t* data_out, size_t DataLength )
+{
+    if (bsp_sx126x_fault_get() != 0U) {
+        if (data_out && DataLength) memset(data_out, 0, DataLength);
+        return false;
+    }
+	spi_transaction_t SPITransaction;
+
+	if ( DataLength > 0 ) {
+		memset( &SPITransaction, 0, sizeof( spi_transaction_t ) );
+		SPITransaction.length = DataLength * 8;
+		SPITransaction.tx_buffer = NULL;
+		SPITransaction.rx_buffer = data_out;
+        if (spi_device_transmit(SpiHandle, &SPITransaction) != ESP_OK) {
+            latch_radio_bus_fault(3U);
+            if (data_out) memset(data_out, 0, DataLength);
+            return false;
+        }
+	}
+
+#ifdef SX126X_SPI_DBUG
+    printf("spi read: ");
+    for(int i =0; i < DataLength ; i++) {
+        printf("%x ",data_out[i]);
+    }
+    printf("\r\n");
+#endif
+	return true;
+}
+
+static uint8_t spi_transfer(uint8_t* data_in, uint8_t* data_out, size_t DataLength)
+{
+    if (bsp_sx126x_fault_get() != 0U) {
+        if (data_out && DataLength) memset(data_out, 0, DataLength);
+        return 0U;
+    }
+	spi_transaction_t SPITransaction;
+
+	if ( DataLength > 0 ) {
+		memset( &SPITransaction, 0, sizeof( spi_transaction_t ) );
+		SPITransaction.length = DataLength * 8;
+		SPITransaction.tx_buffer = data_in;
+		SPITransaction.rx_buffer = data_out;
+        if (spi_device_transmit(SpiHandle, &SPITransaction) != ESP_OK) {
+            latch_radio_bus_fault(3U);
+            if (data_out) memset(data_out, 0, DataLength);
+            return 0U;
+        }
+	}
+
+#ifdef SX126X_SPI_DBUG
+    printf("spi write: ");
+    for(int i =0; i < DataLength ; i++) {
+        printf("%x ",data_in[i]);
+    }
+    printf(",read: ");
+    for(int i =0; i < DataLength ; i++) {
+        printf("%x ",data_out[i]);
